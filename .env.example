# Copy to .env for running the server outside Docker. docker-compose.yml sets its own values.

# all: HTTP and the poll/summary loops in one process. api and worker split them to scale separately.
ROLE=all
LOG_LEVEL=info

# HTTP
PORT=3000
# /livez fails when a loop has not finished a tick for this long.
LOOP_STALL_SECONDS=120

# PostgreSQL. The compose `db` service is published on host port 5433 (5432 is often taken
# by a local PostgreSQL). Change DB_PORT to publish it elsewhere.
DB_PORT=5433
DATABASE_URL=postgres://competitorpulse:competitorpulse@localhost:5433/competitorpulse
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000

# Polling. 900 s = 15 minutes (production). Use 10-15 s to watch the timeline grow in a demo.
POLL_INTERVAL_SECONDS=900
POLL_CONCURRENCY=5
FETCH_TIMEOUT_MS=10000
LISTING_SOURCE_URL=http://localhost:4002

# LLM. Defaults point at the provided mock server (python3 mock-llm/mock-llm-server.py).
# Any OpenAI-compatible endpoint works: set the base URL, key and model.
LLM_BASE_URL=http://localhost:4001/v1
LLM_API_KEY=mock
LLM_MODEL=mock-llm
LLM_TIMEOUT_MS=15000
# 8 attempts with this backoff (the last value repeats) ride out an outage of over 2 hours.
# Compose uses 3 (COMPOSE_LLM_MAX_ATTEMPTS), so injected failures are visible within a demo.
LLM_MAX_ATTEMPTS=8
LLM_BACKOFF_SECONDS=5,20,80,320,1280,3600
LLM_CONCURRENCY=4
