{
  "name": "competitor-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tracks competitor product listings over time and summarises changes with an LLM",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "lint": "oxlint --type-aware",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006"
  }
}
